{
  "name": "portalpic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run pdfjs-assets && vite",
    "build": "bun run pdfjs-assets && tsc -b && vite build && bun scripts/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test",
    "check": "tsc -b && eslint . && bun test && bun run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "pdfjs-assets": "mkdir -p public/pdfjs && cp -R node_modules/pdfjs-dist/wasm node_modules/pdfjs-dist/standard_fonts public/pdfjs/"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@tailwindcss/vite": "4.1.17",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.74.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "5.5.6",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bun": "^1.4.4",
    "@types/node": "22.19.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
